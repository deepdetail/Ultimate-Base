# basedcommander.com on Apache (cPanel). Upload with the rest of the site into public_html.
# Turn on HTTPS with cPanel's own switch (Domains, Force HTTPS Redirect) once the SSL certificate is issued.

Options -Indexes
DirectoryIndex index.html

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/javascript .js
AddCharset utf-8 .html .css .js .webmanifest .txt .xml

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json text/plain application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Pictures and fonts rarely change; keep them for 30 days.
  <FilesMatch "\.(webp|png|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Styles and scripts: an hour, so fixes show up quickly.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # Pages, the app manifest and the offline helper: always check for a newer game.
  <FilesMatch "(\.html|\.webmanifest|^sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
